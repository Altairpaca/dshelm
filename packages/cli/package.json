{
  "name": "dshelm",
  "version": "0.3.0-alpha.0",
  "description": "Explainable multi-model routing and diagnostics for DeepSeek Harness.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altairpaca/dshelm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Altairpaca/dshelm#readme",
  "bugs": {
    "url": "https://github.com/Altairpaca/dshelm/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ai-agent",
    "model-routing",
    "agent-orchestration"
  ],
  "type": "module",
  "bin": {
    "dshelm": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "node ./dist/index.js doctor"
  },
  "dependencies": {
    "@dshelm/auth": "workspace:*",
    "@dshelm/core": "workspace:*",
    "@dshelm/dsh": "workspace:*",
    "@dshelm/model-knowledge": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@earendil-works/pi-ai": "0.82.1",
    "@dshelm/compat-omo": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  }
}
