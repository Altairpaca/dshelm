{
  "name": "dshelm-workspace",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "preview:init": "pnpm build && bash scripts/install-source-preview.sh",
    "docs:check": "node scripts/check-community-docs.mjs",
    "package:check": "node scripts/check-package-metadata.mjs",
    "release:pack": "node scripts/pack-publishable.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "example:first-run": "tsx examples/first-run-routing.ts",
    "example:dsh-execution": "tsx examples/dsh-execution.ts",
    "qa:pack-install": "bash scripts/qa-pack-install.sh",
    "qa:dsh-release-compat": "bash scripts/qa-pack-install.sh --with-dsh-release",
    "qa:web-renderer": "tsx scripts/qa-web-renderer.ts",
    "qa:deepseek-live": "tsx scripts/qa-deepseek-live.ts",
    "bench": "tsx scripts/bench-resolver.ts",
    "qa:dsh-host": "bash scripts/qa-dsh-host.sh",
    "doctor": "pnpm --filter dshelm doctor",
    "doctor:ts": "tsx packages/cli/src/index.ts doctor",
    "migrate:omo": "tsx packages/cli/src/index.ts migrate omo"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fast-check": "^3.23.2",
    "playwright": "^1.52.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
